# Telegram
TELEGRAM_TOKEN=
ADMIN_TELEGRAM_ID=123456789,987654321

# LLM
# Provider: "groq" or "openrouter"
LLM_PROVIDER=openrouter
LLM_MODEL=meta-llama/llama-3.1-8b-instruct
GROQ_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embeddings (provider is always OpenRouter)
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Vision models
VISION_MODEL_PRIMARY=google/gemini-2.0-flash-001
VISION_MODEL_FALLBACK=google/gemini-2.5-flash-preview

# Qdrant — при запуске через docker-compose используй имя сервиса, не localhost
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=university_docs

# ngrok — получи бесплатный статичный домен на dashboard.ngrok.com → Domains
NGROK_AUTHTOKEN=              # токен из ngrok → Your Authtoken
NGROK_DOMAIN=your-domain.ngrok-free.app

# File serving — замени на свой ngrok-домен (должен совпадать с NGROK_DOMAIN)
PDF_BASE_URL=https://your-domain.ngrok-free.app/pdfs

# RAG parameters
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=5
MIN_CHUNK_SCORE=0.55

# Page classifier thresholds
SCAN_TEXT_THRESHOLD=100
SCAN_IMAGE_RATIO=0.70
VISION_MIN_IMAGE_BYTES=10240
PAGE_RENDER_DPI=300

# Duplicate / stale detection
DUPLICATE_THRESHOLD=0.90
STALE_THRESHOLD_LOW=0.75
SQLITE_DB_PATH=data/bot.db
DUPLICATE_DETECTION_LOG=duplicate_detection.log

# Brevo (email verification)
EMAIL_VERIFICATION_ENABLED=true   # false — отключить верификацию, любой пользователь сможет использовать бота
BREVO_API_KEY=                    # API-ключ из Brevo → Transactional → SMTP & API
BREVO_SENDER_EMAIL=               # Верифицированный email отправителя в Brevo
BREVO_SENDER_NAME=AITU Bot        # Имя отправителя (отображается в почте)
