# Telegram
TELEGRAM_TOKEN=
ADMIN_TELEGRAM_ID=123456789

# LLM
# Provider: "groq" or "openrouter"
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embeddings (provider is always OpenRouter)
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Vision models
VISION_MODEL_PRIMARY=google/gemini-2.0-flash-001
VISION_MODEL_FALLBACK=google/gemini-2.5-flash-preview

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=university_docs

# File serving
PDF_BASE_URL=http://localhost:8080/pdfs

# RAG parameters
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=5
MIN_CHUNK_SCORE=0.55

# Page classifier thresholds
SCAN_TEXT_THRESHOLD=100
SCAN_IMAGE_RATIO=0.70
VISION_MIN_IMAGE_BYTES=10240
PAGE_RENDER_DPI=300

# Duplicate / stale detection
DUPLICATE_THRESHOLD=0.90
STALE_THRESHOLD_LOW=0.75
SQLITE_DB_PATH=data/bot.db
DUPLICATE_DETECTION_LOG=duplicate_detection.log

# Brevo (email verification)
BREVO_API_KEY=                    # API-ключ из Brevo → Transactional → SMTP & API
BREVO_SENDER_EMAIL=               # Верифицированный email отправителя в Brevo
BREVO_SENDER_NAME=AITU Bot        # Имя отправителя (отображается в почте)
